# Copy to .env and fill in local values. Never commit .env or .env.prod.

APP_API_PORT=5000

BREVO_API_KEY=your-brevo-api-key
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Community Platform
MAIL_REPLY_TO=support@example.com

MONGO_URI=mongodb://127.0.0.1:27017/community-platform

VITE_APP_PORT=3000
VITE_APP_ENV=development
VITE_APP_APP_NAME=Community Platform
VITE_APP_SERVER_URL=http://localhost:5000
VITE_APP_PORTAL_URL=http://localhost:3000

VITE_APP_ADMIN_URL=http://localhost:3001
VITE_APP_ADMIN_NAME=Community Admin
VITE_APP_ADMIN_PORT=3001

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
PASSWORD_ENCRYPTION_KEY=replace-with-a-32-byte-encryption-key

R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY=your-access-key
R2_SECRET_KEY=your-secret-key
R2_BUCKET=your-bucket
R2_PUBLIC_URL=https://cdn.example.com

CASHFREE_MODE=sandbox
VITE_CASHFREE_MODE=sandbox
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
APP_PORTAL_URL=http://localhost:3000

NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=9876543210
SEED_ADMIN_ID=ADMIN001
# SEED_ADMIN_PASSWORD=set-a-strong-password-when-seeding

VERSION=1.0.0
CONTAINER_REGISTRY=registry.example.com/community-platform/
